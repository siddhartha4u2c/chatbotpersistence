# Copy to .env locally. On Render, set variables in Environment (never commit real keys).
GROQ_API_KEY=

# Optional Groq / OpenAI-compat overrides (defaults are fine for most setups)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_OPENAI_COMPAT_URL=https://api.groq.com/openai/v1

# Optional: where SQLite + ui_state.json are written (defaults to ./.chat_data)
CHATBOT_DATA_DIR=.chat_data

# Isolate storage when running multiple personas on one host
CHATBOT_PROFILE=default

# Uncomment to revert to ephemeral in-process memory only
# CHATBOT_DISABLE_DISK=1
